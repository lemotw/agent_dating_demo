{
  "name": "agent-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typegen": "wrangler types",
    "typecheck": "npm run typegen && tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": { "solid-js": "^1.9.15" },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-solid": "^2.11.14",
    "wrangler": "^4.147.0"
  },
  "engines": { "node": ">=22.12.0" }
}
